// Hackathon Prize Escrow - Stateless LogicSig (Contract Account)
// Releases only when BOTH sponsor (tx0) and organizer (tx1) sign the atomic group.
// This program signs tx index 2: payment or asset transfer from escrow to winner.
// Template params: TMPL_B64_SPONSOR, TMPL_B64_ORGANIZER (32-byte addresses, base64-encoded)

#pragma version 8

// --- Group must be exactly 3 txs: [sponsor, organizer, escrow->winner] ---
global GroupSize
int 3
==

// --- Tx 0 must be from sponsor ---
gtxn 0 Sender
byte base64 TMPL_B64_SPONSOR
==
&&

// --- Tx 1 must be from organizer ---
gtxn 1 Sender
byte base64 TMPL_B64_ORGANIZER
==
&&

// --- Security: no rekey or close remainder ---
txn RekeyTo
global ZeroAddress
==
txn CloseRemainderTo
global ZeroAddress
==
&&
&&

// --- This tx (index 2) must be Payment (1) or Asset Transfer (4) from escrow to winner ---
txn TypeEnum
int 1
==
txn TypeEnum
int 4
==
||
&&

return
