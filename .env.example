# Algorand node (AlgoKit LocalNet or TestNet)
ALGOD_URL=http://localhost:8080
ALGOD_TOKEN=

# Sponsor and Organizer (mnemonics for signing; keep secret)
SPONSOR_MNEMONIC=your 25-word sponsor mnemonic here
ORGANIZER_MNEMONIC=your 25-word organizer mnemonic here

# Optional: pre-computed escrow address (printed by create-escrow)
ESCROW_ADDRESS=

# For agent: optional API port
AGENT_PORT=3000
